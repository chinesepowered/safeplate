# Names only. Real values live on the Convex deployment
# (`convex env set NAME=VALUE`) and never in the repo.

# Written by `convex dev`
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Set on the deployment, not here:
#   JWT_PRIVATE_KEY, JWKS, SITE_URL     - Convex Auth
#   LLM_BASE_URL, LLM_API_KEY, LLM_MODEL, LLM_VISION_MODEL, LLM_EXTRA_BODY
#   FIRECRAWL_API_KEY
#   AGENTMAIL_API_KEY, AGENTMAIL_WEBHOOK_SECRET
#   DEMO_RECIPIENT_OVERRIDE             - redirects all outbound mail in dev
#   ALLOW_REAL_SENDS=1                  - production only, deliberate
#   APP_PAUSED=1                        - kill switch for credit-spending actions
